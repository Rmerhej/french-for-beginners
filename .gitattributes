# =============================================
# Git Line Endings Configuration
# =============================================

# Maven wrapper
mvnw text eol=lf
*.bat text eol=crlf

# Text files → normalize to LF (standard pour les repos)
* text=auto

# === Fichiers source (toujours LF) ===
*.java      text eol=lf
*.kt        text eol=lf
*.groovy    text eol=lf

# === Configuration & Data ===
*.yml       text eol=lf
*.yaml      text eol=lf
*.properties text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.sql       text eol=lf

# === Web / Frontend ===
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.scss      text eol=lf

# === Documentation ===
*.md        text eol=lf
*.txt       text eol=lf
LICENSE     text eol=lf
README*     text eol=lf

# === Autres ===
*.sh        text eol=lf
*.dockerignore text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files (ne pas toucher)
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
