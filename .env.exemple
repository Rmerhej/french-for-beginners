# ==========================================================
# MySQL
# ==========================================================

MYSQL_ROOT_PASSWORD=ChangeThisRootPassword
MYSQL_DATABASE=frenchdb
MYSQL_USER=frenchuser
MYSQL_PASSWORD=ChangeThisDatabasePassword

# ==========================================================
# Administrator account
# ==========================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPassword1

# Clé de signature des cookies "se souvenir de moi" (32 caractères minimum)
# Générer : openssl rand -hex 32
# Cette valeur d'exemple est volontairement trop courte : l'application refuse de démarrer tant qu'elle n'est pas remplacée.
REMEMBER_ME_KEY=A-GENERER

# ==========================================================
# Spring Boot
# ==========================================================

# Utilisées seulement hors Docker (par exemple depuis IntelliJ). Avec Docker, ce sont MYSQL_USER et MYSQL_PASSWORD qui comptent.
SPRING_DATASOURCE_USERNAME=frenchuser
SPRING_DATASOURCE_PASSWORD=ChangeThisDatabasePassword

# ==========================================================
# Version et mémoire (facultatif)
# ==========================================================

# Version de l'application à lancer. Écrite automatiquement par scripts/deploy.sh.
# APP_TAG=v1.15.6

# Mémoire : par défaut prudent pour un serveur de 1 Go. Pour l'A1 (6 Go), décommentez :
# JAVA_OPTS=-Xms256m -Xmx1024m
# MYSQL_BUFFER_POOL=512M

# Alerte si la sauvegarde de la nuit ne se fait pas (facultatif) : adresse « ping » donnée par Healthchecks.io
#HEALTHCHECK_URL=<adresse ping de votre vérification>

# Copie des sauvegardes hors du serveur (facultatif) : <nom du remote rclone>:<nom du bucket>
#OFFSITE_REMOTE=<remote>:<bucket>
